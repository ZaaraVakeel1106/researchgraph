# ============================================================
# RESEARCHGRAPH — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The .env file is in .gitignore and will never be committed.
# This .env.example file is safe to commit.
# ============================================================

# ── OpenAlex API Configuration ───────────────────────────────
# OpenAlex is a free, open scholarly data API.
# No API key is required for standard usage.
# Providing your email in OPENALEX_MAILTO enables the
# "polite pool" with higher rate limits and priority access.
# See: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication

OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=your-email@example.com

# Optional: OpenAlex Premium API key (leave blank for free tier)
OPENALEX_API_KEY=

# ── Database ─────────────────────────────────────────────────
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///./researchgraph.db

# PostgreSQL (optional, for production deployments):
# DATABASE_URL=postgresql://user:password@localhost:5432/researchgraph
