# ============================================================
# RESEARCHGRAPH — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Pytest
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# MyPy
.mypy_cache/
.dmypy.json

# ── Database ─────────────────────────────────────────────────
# SQLite database — auto-created on first run; contains user
# bookmarks, notes, and cached API responses. Do not commit.
*.db
*.sqlite
*.sqlite3

# ── Environment / Secrets ────────────────────────────────────
# Never commit real .env files.
# Use .env.example as the safe template (committed).
.env
.env.local
.env.*.local
.env.production
.env.staging

# ── Node.js / Frontend ───────────────────────────────────────
node_modules/

# Vite production build output — generated by `npm run build`
frontend/dist/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build cache
*.tsbuildinfo

# ── Editor / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc ─────────────────────────────────────────────────────
*.log
*.bak
*.tmp
